{
  "name": "genser-aerospace-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run assets:optimize && next dev",
    "build": "npm run typecheck && npm run lint && npm run assets:optimize && npm run assets:check && npm test && npm run build:info && next build && npm run verify:export",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "assets:check": "node scripts/verify-assets.mjs",
    "verify:export": "node scripts/verify-export.mjs && node scripts/verify-links.mjs",
    "build:info": "node scripts/write-build-info.mjs",
    "design:check": "node scripts/verify-design-system.mjs"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.134.0",
    "vanta": "0.5.24",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.4.6",
    "sharp": "^0.35.5",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "engines": {
    "node": ">=22 <23"
  }
}