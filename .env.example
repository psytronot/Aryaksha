# Set this in the Aryaksha web backend hosting environment after the Orekit service is deployed.
# Example: https://aryaksha-orekit.onrender.com
OREKIT_SERVICE_URL=

# Shared high-entropy secret; configure identically on web and Orekit services.
# Never expose via VITE_* or commit a real value.
ARYAKSHA_OREKIT_SERVICE_TOKEN=
