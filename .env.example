# Set this in the Aryaksha web backend hosting environment after the Orekit service is deployed.
# Example: https://aryaksha-orekit.onrender.com
OREKIT_SERVICE_URL=

# Shared secret: set the identical random value on the web backend and Orekit Render services.
# Never expose this value through a VITE_* variable or commit a real secret.
ARYAKSHA_OREKIT_SERVICE_TOKEN=
